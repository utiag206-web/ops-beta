# ==============================================================================
# INTHALY GLOBAL — VARIABLES DE ENTORNO INDEPENDIENTES
# ==============================================================================

PORT=3001
NODE_ENV=development

# URL canónica de Inthaly ID
INTHALY_ID_URL=http://localhost:3000

# Conexiones independientes a PostgreSQL Soberano (solo esquemas autorizados)
INTHALY_ID_DATABASE_URL=postgresql://inthaly_id_user:inthaly_id_secret_pass@127.0.0.1:5432/inthaly_id
INTHALY_COMMUNITY_DATABASE_URL=postgresql://inthaly_community_user:inthaly_com_secret_pass@127.0.0.1:5432/inthaly_community

# Secreto de sesión exclusiva de INTHALY GLOBAL
INTHALY_GLOBAL_SECRET_KEY=DEFINIR_SECRETO_GLOBAL_SESION_MINIMO_32_CHARS

# Puente temporal de continuidad administrativa
# (Permite acceso de transición mientras se completa el handshake OIDC de producción)
# VALORES: true | false
ENABLE_LEGACY_ADMIN_FALLBACK=true

# Endpoint interno de métricas (Prometheus / cAdvisor en red privada inthaly_internal)
PROMETHEUS_ENDPOINT=http://127.0.0.1:9090

# Configuración de Pruebas Reales de Restauración de Respaldos
BACKUP_STORAGE_DIR=../../infra/backup/storage
RESTORE_TEST_DB_NAME=inthaly_restore_test_db
