  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:ops",
    "dev:ops": "npm run dev --workspace=inthaly-ops",
    "dev:admin": "npm run dev --workspace=global-admin",
    "dev:community": "npm run dev --workspace=community",
    "dev:id": "npm run dev --workspace=inthaly-id",
    "build:ops": "npm run build --workspace=inthaly-ops",
    "build:admin": "npm run build --workspace=global-admin",
    "build:id": "npm run build --workspace=inthaly-id",
    "build:community": "npm run build --workspace=community",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.1",
    "date-fns": "^4.1.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.577.0",
    "next": "^15.1.6",
    "postgres": "^4.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "uuid": "^14.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/types": "^7.24.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
