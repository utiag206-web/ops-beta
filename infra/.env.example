# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO: INFRAESTRUCTURA INTHALY
# ADVERTENCIA: Este archivo contiene valores de ejemplo.
# En producción, copia este archivo a '.env' y define contraseñas criptográficas
# de alta entropía (mínimo 32 caracteres aleatorios). NUNCA subas '.env' a Git.
# ==============================================================================

# ENTORNO
NODE_ENV=production
APP_DOMAIN=inthaly.com

# SUPERUSUARIO DE POSTGRESQL (ADMINISTRACIÓN GLOBAL)
POSTGRES_SUPERUSER=inthaly_admin
POSTGRES_SUPERUSER_PASSWORD=DEFINIR_PASSWORD_SUPERUSUARIO_AQUI_ALTA_ENTROPIA

# BASE DE DATOS DEDICADA: INTHALY ID
INTHALY_ID_DB_NAME=inthaly_id
INTHALY_ID_DB_USER=inthaly_id_user
INTHALY_ID_DB_PASSWORD=DEFINIR_PASSWORD_INTHALY_ID_AQUI
# Cadena de conexión interna para la aplicación Next.js
INTHALY_ID_DATABASE_URL=postgresql://inthaly_id_user:DEFINIR_PASSWORD_INTHALY_ID_AQUI@127.0.0.1:5432/inthaly_id?schema=inthaly_id

# BASE DE DATOS DEDICADA: COMUNIDAD INTHALY
INTHALY_COMMUNITY_DB_NAME=inthaly_community
INTHALY_COMMUNITY_DB_USER=inthaly_community_user
INTHALY_COMMUNITY_DB_PASSWORD=DEFINIR_PASSWORD_COMUNIDAD_AQUI
# Cadena de conexión interna para la aplicación Comunidad
INTHALY_COMMUNITY_DATABASE_URL=postgresql://inthaly_community_user:DEFINIR_PASSWORD_COMUNIDAD_AQUI@127.0.0.1:5432/inthaly_community?schema=inthaly_community

# REDIS (SESIONES Y CACHÉ)
REDIS_PASSWORD=DEFINIR_PASSWORD_REDIS_AQUI
REDIS_URL=redis://:DEFINIR_PASSWORD_REDIS_AQUI@127.0.0.1:6379

# SECRETOS CRIPTOGRÁFICOS DE IDENTIDAD (JWT & OIDC)
INTHALY_ID_JWT_SECRET=DEFINIR_SECRETO_HEX_64_CARACTERES_MINIMO_PARA_JWT
CONSOLE_OIDC_SECRET=DEFINIR_SECRETO_CONFIDENCIAL_CONSOLA_GLOBAL
ACADEMY_OIDC_SECRET=DEFINIR_SECRETO_CONFIDENCIAL_ACADEMIA_LARAVEL

# POLÍTICA DE RESPALDOS
RETENTION_DAYS=30
BACKUP_SCHEDULE="0 */6 * * *" # Cada 6 horas

# ALMACENAMIENTO DE OBJETOS: MINIO S3
MINIO_ROOT_USER=inthaly_storage_admin
MINIO_ROOT_PASSWORD=DEFINIR_PASSWORD_MINIO_AQUI_ALTA_ENTROPIA
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
S3_PUBLIC_URL=http://127.0.0.1:9000/community-media

# PROVEEDOR DE CORREO TRANSACCIONAL (PENDIENTE DE CONFIGURACIÓN)
# RESEND_API_KEY=re_...
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=585
# SMTP_USER=postmaster@inthaly.com
# SMTP_PASSWORD=...
