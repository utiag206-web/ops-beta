# =========================================================================
# SYSTEM ENVIRONMENT VARIABLES (Vercel / Production)
# =========================================================================

# 1. Supabase Public URL
# Description: The URL of your Supabase project REST API.
# Required in both client and server environments.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# 2. Supabase Anon Key
# Description: The public anonymous key for client-side Supabase interactions.
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# 3. Supabase Service Role Key
# Description: The secret key with full database access (bypasses RLS).
# NEVER expose this to the browser. Only used in server actions/components.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
